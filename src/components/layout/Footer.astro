---
import { FOOOTER_LINKS } from "@/data/constants";
---

<footer
	class="flex w-full flex-col items-center justify-center gap-y-4 text-center text-gray-500 sm:flex-row sm:justify-between sm:text-xs"
>
	<nav
		aria-label="More about evenzero"
		class="flex w-full flex-wrap justify-center gap-x-2 gap-y-2 sm:justify-between"
	>
		{
			FOOOTER_LINKS.map((link) => (
				<a
					target="_blank"
					href={link.path}
					class="px-2 py-1 text-[10px] uppercase transition-colors hover:text-textColor hover:underline sm:px-2 sm:py-0"
				>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
