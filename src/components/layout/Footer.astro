---
import { FOOOTER_LINKS } from "@/data/constants";
---

<footer class="w-full text-center text-gray-500">
	<nav
		aria-label="More about evenzero"
		class="flex w-full flex-row flex-nowrap items-center justify-between text-[9px] xs:text-[10px] sm:text-xs"
	>
		{
			FOOOTER_LINKS.map((link) => (
				<a
					target="_blank"
					href={link.path}
					class="px-1 py-0 uppercase whitespace-nowrap transition-colors hover:text-textColor hover:underline shrink-0"
				>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
