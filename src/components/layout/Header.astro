---
import { MENU_LINKS } from "@/data/constants";

const url = new URL(Astro.request.url);
---

<header id="main-header" class="mb-4 sm:mb-6 md:mb-10 flex h-20 w-full justify-between items-center">
	<div class="flex items-center">
		<button
			type="button"
			id="logo-theme-toggle"
			class="h-20 w-20 eo p-1 cursor-pointer focus:outline-none transition-transform hover:scale-105 active:scale-95 shrink-0"
			aria-label="Toggle theme"
			title="Click to toggle theme"
		>
			<div class="-mt-1 text-white"></div>
		</button>
		<nav id="navigation-menu" class="ml-2 sm:ml-4 justify-center h-full flex flex-col text-xs sm:text-sm" aria-label="Main menu">
			{
				MENU_LINKS.map((link) => (
					<a
						href={link.path}
						class="py-[1px] uppercase leading-tight hover:text-accent-2 hover:text-linkHover hover:no-underline"
						aria-current={url.pathname === link.path ? "page" : false}
					>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	const logoBtn = document.getElementById("logo-theme-toggle");
	logoBtn?.addEventListener("click", () => {
		document.documentElement.classList.toggle("dark");
	});
</script>
