---
import { Pagination } from "webcoreui/astro";

interface Props {
  totalPages: number;
}

const { totalPages } = Astro.props;
// Third-party widget script. It is loaded on demand (see the script below),
// not while the section that uses it is hidden by the pagination.
const widgetScript = "/scripts/cg.js";
---

<div data-section-pagination data-widget-script={widgetScript}>
  <div data-pagination-content><slot /></div>
  {
    totalPages > 1 && (
      <nav class="section-pagination" aria-label="Section pagination" hidden>
        <Pagination totalPages={totalPages} currentPage={1} type={"arrows"} />
      </nav>
    )
  }
</div>

<style>
  .section-pagination {
    margin-top: 2rem;
    margin-bottom: 6rem;
  }
  .section-pagination[hidden],
  [data-pagination-content] :global([hidden]) {
    display: none !important;
  }
  .section-pagination :global(ul) {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .section-pagination :global(li) {
    padding: 0;
    margin: 0;
  }
  .section-pagination :global(button) {
    font: inherit;
    color: var(--theme-text);
    background: transparent;
    border: 1px solid var(--theme-text);
    border-radius: 0.25rem;
    box-shadow: none;
    padding: 0.4rem 0.65rem;
  }
  .section-pagination :global(button:hover:not(:disabled)),
  .section-pagination :global(button[data-active="true"]) {
    color: var(--theme-bg);
    background: var(--theme-text);
    box-shadow: none;
  }
  .section-pagination :global(button:focus-visible) {
    outline: 2px solid var(--theme-link);
    outline-offset: 2px;
  }
  .section-pagination :global(button:disabled) {
    opacity: 0.5;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-section-pagination]");
  const content = root?.querySelector<HTMLElement>("[data-pagination-content]");
  const nav = root?.querySelector<HTMLElement>(".section-pagination");
  const pagination = nav?.querySelector<HTMLElement>(
    '[data-id="w-pagination"]',
  );

  // Widgets are custom elements (e.g. <coingecko-coin-price-chart-widget>).
  // They size their canvases from the layout of their container when they
  // mount, and Chart.js also re-measures while a section is hidden. Because
  // `display: none` has zero width, a chart that was mounted or left in a
  // hidden page stays collapsed to 0px after the page is shown again.
  const isWidget = (element: Element): element is HTMLElement =>
    element instanceof HTMLElement && element.localName.includes("-");
  const widgets = content
    ? Array.from(content.querySelectorAll<HTMLElement>("*")).filter(isWidget)
    : [];
  const widgetScriptSrc = root?.dataset.widgetScript;
  let widgetScriptRequested = false;

  function loadWidgetScript() {
    if (!widgetScriptSrc || widgetScriptRequested || !widgets.length) return;
    // Another component may already have registered the widget.
    if (
      typeof customElements !== "undefined" &&
      widgets.every((widget) => customElements.get(widget.localName))
    )
      return;
    widgetScriptRequested = true;
    const script = document.createElement("script");
    script.src = widgetScriptSrc;
    script.async = false;
    document.head.appendChild(script);
  }

  // `vue-custom-element` (used by cg.js) exposes the mounted component on the
  // host. `chart` is the Chart.js instance; `updateContainerClass` recomputes
  // the widget's small/large layout from the container width.
  type WidgetHost = HTMLElement & {
    getVueInstance?: () =>
      | {
          chart?: { resize?: () => void };
          updateContainerClass?: () => void;
        }
      | undefined;
  };

  if (root && content && nav && pagination) {
    const elements = Array.from(content.children) as HTMLElement[];
    const groups: HTMLElement[][] = [];
    let currentGroup: HTMLElement[] | undefined;
    for (const element of elements) {
      if (element.tagName === "H2") {
        currentGroup = [];
        groups.push(currentGroup);
      }
      currentGroup?.push(element);
    }
    const perPage = 1;
    const total = Math.ceil(groups.length / perPage);
    const buttons = Array.from(
      pagination.querySelectorAll<HTMLButtonElement>("button[data-page]"),
    );

    function widgetsOnPage(page: number): HTMLElement[] {
      return (groups[page - 1] ?? []).flatMap((element) => [
        ...(isWidget(element) ? [element] : []),
        ...Array.from(element.querySelectorAll<HTMLElement>("*")).filter(
          isWidget,
        ),
      ]);
    }

    // Replacing a widget with a fresh element makes the custom element mount
    // again, this time against a laid-out (visible) container. This is only a
    // last resort for widgets that offer no way to re-measure themselves; a
    // refresh runs on page changes only, so it cannot loop.
    function remount(widget: HTMLElement) {
      const fresh = document.createElement(widget.localName);
      for (const { name, value } of widget.attributes)
        fresh.setAttribute(name, value);
      while (widget.firstChild) fresh.appendChild(widget.firstChild);
      widget.replaceWith(fresh);
      // Keep the page groups in sync if the widget itself is a page element.
      for (const group of groups) {
        const index = group.indexOf(widget);
        if (index !== -1) group[index] = fresh;
      }
    }

    let refreshFrame: number | undefined;

    function refreshWidgets() {
      // Coalesce the initial showPage(1) + pageForHash() pair into one refresh.
      if (refreshFrame !== undefined) cancelAnimationFrame(refreshFrame);
      refreshFrame = requestAnimationFrame(() => {
        refreshFrame = undefined;
        const page = Number(pagination!.dataset.currentPage) || 1;
        const visibleWidgets = widgetsOnPage(page);
        if (!visibleWidgets.length) return;
        loadWidgetScript();

        for (const widget of visibleWidgets) {
          try {
            const instance = (widget as WidgetHost).getVueInstance?.();
            instance?.chart?.resize?.();
            instance?.updateContainerClass?.();
          } catch {
            // A widget that has not upgraded yet (or failed to) must never
            // break pagination; the fallback below handles hidden mounts.
          }
        }
        // Generic fallback for widgets that only react to a window resize.
        window.dispatchEvent(new Event("resize"));

        // If a chart is still zero-width while its widget is visible, it was
        // initialised with no layout. Give it a fresh element to mount again.
        for (const widget of visibleWidgets) {
          const canvas = (widget.shadowRoot ?? widget).querySelector("canvas");
          if (
            canvas &&
            widget.getClientRects().length > 0 &&
            canvas.getBoundingClientRect().width < 1
          ) {
            remount(widget);
          }
        }
      });
    }

    function showPage(page: number) {
      page = Math.max(1, Math.min(total, page));
      groups.forEach((group, index) =>
        group.forEach((element) => {
          element.hidden = Math.floor(index / perPage) + 1 !== page;
        }),
      );
      pagination!.dataset.currentPage = String(page);
      buttons.forEach((button) => {
        const value = button.dataset.page;
        button.disabled = value === "prev" ? page === 1 : page === total;
        button.setAttribute(
          "aria-label",
          value === "prev" ? "Previous entry" : "Next entry",
        );
      });
      // Start the widget download as soon as its section is on screen, and
      // re-layout any widget that was mounted/resized while it was hidden.
      if (widgetsOnPage(page).length) loadWidgetScript();
      refreshWidgets();
    }

    function pageForHash() {
      if (!location.hash) return;
      let id: string;
      try {
        id = decodeURIComponent(location.hash.slice(1));
      } catch {
        return;
      }
      const target = document.getElementById(id);
      if (!target) return;
      const index = groups.findIndex((group) =>
        group.some((element) => element === target || element.contains(target)),
      );
      if (index >= 0) {
        showPage(Math.floor(index / perPage) + 1);
        target.scrollIntoView();
      }
    }

    showPage(1);
    nav.hidden = false;
    pageForHash();
    window.addEventListener("hashchange", pageForHash);
    // Handle navigation here so fragment links and the arrows share the same page state.
    nav.addEventListener(
      "click",
      (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>(
          "button[data-page]",
        );
        if (!button || button.disabled) return;
        event.stopPropagation();
        const current = Number(pagination.dataset.currentPage);
        showPage(current + (button.dataset.page === "prev" ? -1 : 1));
        // A stale fragment would make re-selecting the same table-of-contents link a no-op.
        if (location.hash)
          history.replaceState(null, "", location.pathname + location.search);
        content.scrollIntoView({ behavior: "smooth", block: "start" });
      },
      { capture: true },
    );
  } else if (widgets.length) {
    // No pagination: every section is visible, so mount widgets immediately.
    loadWidgetScript();
  }
</script>
