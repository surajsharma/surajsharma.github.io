---
---

<canvas class="vhs-canvas" aria-hidden="true"></canvas>

<script>
	// Degraded VHS tape + CRT monitor effect.
	// Ported from the Ghostty custom shader (~/Downloads/vhs.glsl by Alex Brinsmead).
	// Renders the shader fullscreen via WebGL2 and keeps it layered behind the page content.
	const SHADER_URL = "/vhs.glsl";

	let canvas = null;
	let rafId = 0;
	let frameIndex = 0;

	const VERT = `#version 300 es
precision highp float;
layout(location = 0) in vec2 aPos;
out vec2 vUv;
void main() {
	vUv = (aPos + vec2(1.0, 1.0)) / 2.0;
	gl_Position = vec4(aPos.x, aPos.y, 0.0, 1.0);
}`;

	const FRAG = `#version 300 es
precision highp float;
uniform vec2 iResolution;
uniform float iTime;
uniform sampler2D iChannel0;
in vec2 vUv;
layout(location = 0) out vec4 fragColor;

__SHADER__

void main() {
	vec2 fragCoord = vUv * iResolution;
	vec4 fc = vec4(0.0);
	mainImage(fc, fragCoord);
	fragColor = fc;
}
`;

	async function init() {
		const canvasEl = document.querySelector(".vhs-canvas");
		if (!canvasEl) return;
		const gl2 = canvasEl.getContext("webgl2", { antialias: false, alpha: true });
		if (!gl2) {
			console.warn("VHSShader: WebGL2 is not supported in this browser, skipping.");
			return;
		}
		const gl = gl2;
		canvas = canvasEl;

		const shaderResponse = await fetch(SHADER_URL);
		const userShader = (await shaderResponse.text()).trim();
		const fragShaderSource = FRAG.replace("__SHADER__", userShader);

		const compileShader = (type, source) => {
			const shader = gl.createShader(type);
			if (!shader) return null;
			gl.shaderSource(shader, source);
			gl.compileShader(shader);
			if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
				console.error("VHSShader compile error:", gl.getShaderInfoLog(shader));
				return null;
			}
			return shader;
		};

		const vs = compileShader(gl.VERTEX_SHADER, VERT);
		const fs = compileShader(gl.FRAGMENT_SHADER, fragShaderSource);
		if (!vs || !fs) return;

		const program = gl.createProgram();
		if (!program) return;
		gl.attachShader(program, vs);
		gl.attachShader(program, fs);
		gl.linkProgram(program);
		if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
			console.error("VHSShader link error:", gl.getProgramInfoLog(program));
			return;
		}
		gl.useProgram(program);
		const uResolution = gl.getUniformLocation(program, "iResolution");
		const uTime = gl.getUniformLocation(program, "iTime");
		const uChannel = gl.getUniformLocation(program, "iChannel0");
		if (!uResolution || !uTime || !uChannel) return;

		const textureSize = 256;
		const noise = new Uint8Array(textureSize * textureSize * 4);
		for (let i = 0; i < noise.length; i += 4) {
			const value = Math.abs(Math.sin(i * 12.9898) * 43758.5453) % 1;
			const v = Math.floor(value * 255);
			noise[i] = v;
			noise[i + 1] = Math.min(255, v + 12);
			noise[i + 2] = Math.max(0, v - 12);
			noise[i + 3] = 255;
		}
		const tex = gl.createTexture();
		if (!tex) return;
		gl.bindTexture(gl.TEXTURE_2D, tex);
		gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, textureSize, textureSize, 0, gl.RGBA, gl.UNSIGNED_BYTE, noise);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
		const sam = gl.createSampler();
		if (!sam) return;
		gl.bindSampler(gl.TEXTURE0, sam);
		gl.samplerParameteri(sam, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
		gl.samplerParameteri(sam, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
		gl.samplerParameteri(sam, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
		gl.samplerParameteri(sam, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);

		const buffer = gl.createBuffer();
		if (!buffer) return;
		gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		const vao = gl.createVertexArray();
		if (!vao) return;
		gl.bindVertexArray(vao);
		gl.enableVertexAttribArray(0);
		gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
		gl.bindVertexArray(null);

		let startedAt = performance.now();

		const resize = () => {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const width = Math.max(1, Math.round(canvas.clientWidth * dpr));
			const height = Math.max(1, Math.round(canvas.clientHeight * dpr));
			if (canvas.width !== width || canvas.height !== height) {
				canvas.width = width;
				canvas.height = height;
			}
		};
		window.addEventListener("resize", resize);
		const observer = new ResizeObserver(resize);
		observer.observe(canvasEl);
		resize();

		const renderFrame = (now) => {
			gl.uniform2f(uResolution, canvas.width, canvas.height);
			gl.uniform1f(uTime, (now - startedAt) / 1000);
			gl.bindTexture(gl.TEXTURE_2D, tex);
			gl.bindSampler(gl.TEXTURE0, sam);
			gl.bindVertexArray(vao);
			gl.enable(gl.BLEND);
			gl.blendFuncSeparate(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA, gl.ONE, gl.ZERO);
			gl.viewport(0, 0, canvas.width, canvas.height);
			gl.clearColor(0, 0, 0, 0);
			gl.clear(gl.COLOR_BUFFER_BIT);

			// Recalculate the static background noise every frame so the static
			// never sits motionless and the layer always looks alive.
			const frameNoise = new Uint8Array(textureSize * textureSize * 4);
			for (let i = 0; i < frameNoise.length; i += 4) {
				const value = Math.abs(Math.sin((i * 12.9898) + (frameIndex * 97.0)) * 43758.5453) % 1;
				const v = Math.floor(value * 255);
				frameNoise[i] = v;
				frameNoise[i + 1] = Math.min(255, v + 12);
				frameNoise[i + 2] = Math.max(0, v - 12);
				frameNoise[i + 3] = 255;
			}
			gl.bindTexture(gl.TEXTURE_2D, tex);
			gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, textureSize, textureSize, 0, gl.RGBA, gl.UNSIGNED_BYTE, frameNoise);

			gl.drawArrays(gl.TRIANGLES, 0, 3);
			frameIndex = (frameIndex + 1) % 100000;
			rafId = requestAnimationFrame(renderFrame);
		};

		rafId = requestAnimationFrame(renderFrame);
	}

	init();
</script>

<style>
	.vhs-canvas {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		pointer-events: none;
		z-index: -1;
	}
</style>
