---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import SectionPagination from "@/components/SectionPagination";
import PostLayout from "@/layouts/BlogPost";

export const getStaticPaths = (async () => {
	const blogEntries = await getCollection("post");
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const paginateSections = ["projects", "experiments"].includes(entry.slug);
const totalPages = Math.ceil(headings.filter((heading) => heading.depth === 2).length);
---

<PostLayout post={entry}>
	{paginateSections ? (
		<SectionPagination totalPages={totalPages}><Content /></SectionPagination>
	) : <Content />}
</PostLayout>
